# Copy to apps/ios/.env and fill in your own values. .env is gitignored.
#
# Your Apple Developer team ID. Find it in Xcode > Settings > Accounts, or read
# it from a provisioning profile:
#   security cms -D -i ~/Library/Developer/Xcode/UserData/Provisioning\ Profiles/*.mobileprovision \
#     | grep -A1 TeamIdentifier
#
# A free personal team works for development on your own devices. A paid account
# is required before the real app works, because sharing rules between the app
# and its extensions needs an App Group.
DEVELOPMENT_TEAM=
